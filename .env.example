# HandwritingLab Environment Configuration

# Flask Web Server Configuration
PORT=5000
HOST=0.0.0.0
DEBUG=False
SECRET_KEY=handwriting-detector-secret-key-change-in-production

# Optional: Custom path to Tesseract OCR binary (if not in PATH or default install directory)
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux example: /usr/bin/tesseract
TESSERACT_CMD=
